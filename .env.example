# Local dev (docker-compose Postgres, exposed on host port 55432):
DATABASE_URL="postgresql://finsight:finsight@localhost:55432/finsight"
# Cloud (Neon, Render, etc.) — use instead when pointing at a managed Postgres:
# DATABASE_URL="postgresql://user:password@host:5432/finsight?sslmode=require"
PORT=3000
NODE_ENV=development
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
CORS_ORIGIN="*"

# Used only by `npm run seed` to create your personal user — never exposed via an HTTP endpoint.
SEED_EMAIL="you@example.com"
SEED_PASSWORD="change-me"
